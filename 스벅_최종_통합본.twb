      <column caption='당류' datatype='string' name='[Calculation_1961833034043395]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([Calculation_0101458548658182], 1)) + &quot; g&quot;' />
      </column>
      <column caption='칼로리' datatype='string' name='[Calculation_1961833034694661]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([Calculation_0101458548121600], 1)) + &quot; kcal&quot;' />
      </column>
      <column caption='카카페인' datatype='string' name='[Calculation_1961833035141127]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([Calculation_0101458548600837], 1)) + &quot; mg&quot;' />
      </column>
      <column caption='저당 라떼/모카/프라푸치노 여부' datatype='string' name='[Calculation_1961833164095496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0220754679754754] = &quot;저당&quot; &#13;&#10;   AND (&#13;&#10;       (CONTAINS([제품명], &quot;라떼&quot;) AND NOT CONTAINS([제품명], &quot;티&quot;) AND NOT CONTAINS([제품명], &quot;말차&quot;))&#13;&#10;       OR CONTAINS([제품명], &quot;모카&quot;)&#13;&#10;       OR CONTAINS([제품명], &quot;프라푸치노&quot;)&#13;&#10;   )&#13;&#10;THEN &quot;포함&quot;&#13;&#10;ELSE &quot;제외&quot;&#13;&#10;END' />
      </column>
      <column caption='건강 음료' datatype='string' name='[Calculation_1961833168826378]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([제품명], &quot;클렌즈&quot;) &#13;&#10;   OR CONTAINS([제품명], &quot;ABC&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;케일&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;라이트&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;에너지&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;스퀴즈드&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;유기농&quot;)&#13;&#10;   OR (CONTAINS([제품명], &quot;주스&quot;) AND [당류(g)] &lt;= 20)&#13;&#10;THEN &quot;건강 음료&quot;&#13;&#10;ELSE &quot;일반 음료&quot;&#13;&#10;END' />
      </column>
      <column caption='식물성 음료 여부' datatype='string' name='[Calculation_1961833177468939]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([제품명], &quot;오트&quot;) &#13;&#10;   OR CONTAINS([제품명], &quot;아몬드&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;코코넛&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;두유&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;콩&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;식물성&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;비건&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;vegan&quot;)&#13;&#10;THEN &quot;식물성 음료&quot;&#13;&#10;ELSE &quot;일반 음료&quot;&#13;&#10;END' />
      </column>
      <column caption='전통 재료 이름' datatype='string' name='[Calculation_1961833179824140]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([제품명], &quot;인절미&quot;) THEN &quot;인절미(밤/고구마)&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;호떡&quot;) THEN &quot;호떡(고구마)&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;쑥&quot;) THEN &quot;쑥&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;까망&quot;) THEN &quot;까망(흑임자)&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;유자&quot;) THEN &quot;유자&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;말차&quot;) OR CONTAINS([제품명], &quot;녹차&quot;) THEN &quot;말차/녹차&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;쌍화&quot;) THEN &quot;쌍화차&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;생강&quot;) THEN &quot;생강&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;대추&quot;) THEN &quot;대추&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;감잎&quot;) THEN &quot;감잎&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;모과&quot;) THEN &quot;모과&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;수정과&quot;) THEN &quot;수정과&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;식혜&quot;) THEN &quot;식혜&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;매실&quot;) THEN &quot;매실&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;오미자&quot;) THEN &quot;오미자&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;둥글레&quot;) THEN &quot;둥글레&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;옥수수&quot;) THEN &quot;옥수수&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;보리&quot;) THEN &quot;보리&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;현미&quot;) THEN &quot;현미&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;흑미&quot;) THEN &quot;흑미&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;밤&quot;) THEN &quot;밤&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;고구마&quot;) THEN &quot;고구마&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;흑임자&quot;) THEN &quot;흑임자&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;귀리&quot;) THEN &quot;귀리&quot;&#13;&#10;ELSE &quot;일반&quot;&#13;&#10;END' />
      </column>
      <column caption='전통 재료 추천 온도' datatype='string' name='[Calculation_1961833184710669]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// 먼저 전통 재료인지 확인&#13;&#10;IF [Calculation_1961833179824140] = &quot;일반&quot; THEN &quot;일반&quot;&#13;&#10;// 매실/오미자/식혜/수정과는 아이스 추천&#13;&#10;ELSEIF [Calculation_1961833179824140] = &quot;매실&quot;&#13;&#10;   OR [Calculation_1961833179824140] = &quot;오미자&quot;&#13;&#10;   OR [Calculation_1961833179824140] = &quot;식혜&quot;&#13;&#10;   OR [Calculation_1961833179824140] = &quot;수정과&quot; THEN &quot;아이스 추천&quot;&#13;&#10;// 나머지 전통 재료는 핫 추천&#13;&#10;ELSE &quot;핫 추천&quot;&#13;&#10;END' />
      </column>
      <column caption='비건/유당불내증 추천' datatype='string' name='[Calculation_1961833193299982]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([제품명], &quot;오트&quot;) THEN &quot;비건 추천 (오트 밀크)&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;우유&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;밀크&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;라떼&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;카푸치노&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;모카&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;크림&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;아포가토&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;브레베&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;플로트&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;몰트&quot;) THEN &quot;유당 포함 (주의)&quot;&#13;&#10;ELSE &quot;비건/유당불내증 가능&quot;&#13;&#10;END' />
      </column>
      <column caption='카페인 당 구분' datatype='string' name='[Calculation_2179260214050818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [카페인(mg)] &gt;= 200 AND [당류(g)] &gt;= 20 THEN &quot;고카페인+고당류&quot;&#13;&#10;ELSEIF [카페인(mg)] &gt;= 200 AND [당류(g)] &lt; 20 THEN &quot;고카페인+저당류&quot;&#13;&#10;ELSEIF [카페인(mg)] &lt; 200 AND [당류(g)] &gt;= 20 THEN &quot;저카페인+고당류&quot;&#13;&#10;ELSE &quot;저카페인+저당류&quot;&#13;&#10;END' />
      </column>
      <column caption='starbucks_menu_260112.csv' datatype='table' name='[__tableau_internal_object_id__].[starbucks_menu_260112.csv_A700126A90514F498C78151E46913E53]' role='measure' type='quantitative' />
      <column caption='나트륨(Mg)' datatype='integer' name='[나트륨(mg)]' role='measure' type='quantitative' />
