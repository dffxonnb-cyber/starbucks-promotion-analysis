      <column caption='지역 한정 여부' datatype='string' name='[Calculation_0220754679590912]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([제품명], &quot;제주&quot;) OR CONTAINS([제품명], &quot;여수&quot;) &#13;&#10;   OR CONTAINS([제품명], &quot;의암호&quot;) OR CONTAINS([제품명], &quot;북한산&quot;) &#13;&#10;   OR CONTAINS([제품명], &quot;1호점&quot;) &#13;&#10;THEN &quot;지역 한정&quot;&#13;&#10;ELSE &quot;일반&quot;&#13;&#10;END' />
      </column>
      <column caption='칼로리 등급' datatype='string' name='[Calculation_0220754679648257]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [1회 제공량(kcal)] &lt;= 5 THEN &quot;제로 칼로리&quot;&#13;&#10;ELSEIF [1회 제공량(kcal)] &lt;= 150 THEN &quot;저칼로리&quot;&#13;&#10;ELSEIF [1회 제공량(kcal)] &lt;= 300 THEN &quot;중칼로리&quot;&#13;&#10;ELSE &quot;고칼로리&quot;&#13;&#10;END' />
      </column>
