      <column caption='커피 포함 여부' datatype='string' name='[Calculation_1431593318232064]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([제품명], &quot;콜드 브루&quot;) &#13;&#10;   OR CONTAINS([제품명], &quot;나이트로&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;브루드 커피&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;에스프레소&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;아메리카노&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;라떼&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;카푸치노&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;모카&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;코르타도&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;플랫 화이트&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;마키아또&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;아포가토&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;브레베&quot;)&#13;&#10;THEN &quot;커피 포함&quot;&#13;&#10;ELSE &quot;커피 미포함&quot;&#13;&#10;END' />
      </column>
      <column caption='대분류' datatype='string' name='[Calculation_1603390474362882]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// 대분류 계산 필드&#13;&#10;IF CONTAINS([제품명], &quot;콜드 브루&quot;) OR CONTAINS([제품명], &quot;나이트로&quot;) THEN &quot;콜드 브루&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;브루드 커피&quot;) THEN &quot;브루드 커피&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;에스프레소&quot;) OR CONTAINS([제품명], &quot;아메리카노&quot;) OR CONTAINS([제품명], &quot;마키아또&quot;) OR CONTAINS([제품명], &quot;아포가토&quot;) OR CONTAINS([제품명], &quot;더블 샷&quot;) OR CONTAINS([제품명], &quot;코르타도&quot;) OR CONTAINS([제품명], &quot;플랫 화이트&quot;) OR CONTAINS([제품명], &quot;라떼&quot;) OR CONTAINS([제품명], &quot;카푸치노&quot;) OR CONTAINS([제품명], &quot;모카&quot;) OR CONTAINS([제품명], &quot;브레베&quot;) THEN &quot;에스프레소&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;프라푸치노&quot;) THEN &quot;프라푸치노&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;블렌디드&quot;) THEN &quot;블렌디드&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;리프레셔&quot;) THEN &quot;스타벅스 리프레셔&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;피지오&quot;) THEN &quot;스타벅스 피지오&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;티&quot;) AND NOT CONTAINS([제품명], &quot;라떼&quot;) AND NOT CONTAINS([제품명], &quot;블렌디드&quot;) THEN &quot;티(티바나)&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;초콜릿&quot;) OR CONTAINS([제품명], &quot;우유&quot;) AND NOT CONTAINS([제품명], &quot;라떼&quot;) OR CONTAINS([제품명], &quot;셔벗&quot;) AND NOT CONTAINS([제품명], &quot;피지오&quot;) THEN &quot;기타 제조 음료&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;주스&quot;) AND (CONTAINS([제품명], &quot;ML&quot;) OR CONTAINS([제품명], &quot;190&quot;) OR CONTAINS([제품명], &quot;100&quot;)) OR CONTAINS([제품명], &quot;요거트&quot;) AND CONTAINS([제품명], &quot;190&quot;) OR CONTAINS([제품명], &quot;클렌즈&quot;) THEN &quot;스타벅스 주스(병음료)&quot;&#13;&#10;ELSE &quot;기타&quot;&#13;&#10;END' />
      </column>
      <column caption='중분류' datatype='string' name='[Calculation_1603390474448899]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// 중분류 계산 필드&#13;&#10;IF [Calculation_1603390474362882] = &quot;콜드 브루&quot; THEN&#13;&#10;    IF CONTAINS([제품명], &quot;나이트로&quot;) THEN &quot;나이트로&quot;&#13;&#10;    ELSEIF CONTAINS([제품명], &quot;리저브&quot;) THEN &quot;리저브&quot;&#13;&#10;    ELSEIF CONTAINS([제품명], &quot;제주&quot;) OR CONTAINS([제품명], &quot;여수&quot;) THEN &quot;지역 한정&quot;&#13;&#10;    ELSE &quot;기본 콜드 브루&quot;&#13;&#10;    END&#13;&#10;ELSEIF [Calculation_1603390474362882] = &quot;브루드 커피&quot; THEN&#13;&#10;    IF CONTAINS([제품명], &quot;아이스&quot;) THEN &quot;아이스 브루드 커피&quot;&#13;&#10;    ELSE &quot;핫 브루드 커피&quot;&#13;&#10;    END&#13;&#10;ELSEIF [Calculation_1603390474362882] = &quot;에스프레소&quot; THEN&#13;&#10;    IF CONTAINS([제품명], &quot;라떼&quot;) AND NOT CONTAINS([제품명], &quot;티&quot;) AND NOT CONTAINS([제품명], &quot;말차&quot;) THEN &quot;라떼&quot;&#13;&#10;    ELSEIF CONTAINS([제품명], &quot;카푸치노&quot;) THEN &quot;카푸치노&quot;&#13;&#10;    ELSEIF CONTAINS([제품명], &quot;아메리카노&quot;) THEN &quot;아메리카노&quot;&#13;&#10;    ELSEIF CONTAINS([제품명], &quot;마키아또&quot;) THEN &quot;마키아또&quot;&#13;&#10;    ELSEIF CONTAINS([제품명], &quot;모카&quot;) THEN &quot;모카&quot;&#13;&#10;    ELSEIF CONTAINS([제품명], &quot;플랫 화이트&quot;) THEN &quot;플랫 화이트&quot;&#13;&#10;    ELSE &quot;기타 에스프레소&quot;&#13;&#10;    END&#13;&#10;ELSEIF [Calculation_1603390474362882] = &quot;프라푸치노&quot; THEN&#13;&#10;    IF CONTAINS([제품명], &quot;크림&quot;) THEN &quot;크림 프라푸치노&quot;&#13;&#10;    ELSEIF CONTAINS([제품명], &quot;제주&quot;) OR CONTAINS([제품명], &quot;여수&quot;) THEN &quot;지역 한정 프라푸치노&quot;&#13;&#10;    ELSE &quot;커피 프라푸치노&quot;&#13;&#10;    END&#13;&#10;ELSEIF [Calculation_1603390474362882] = &quot;블렌디드&quot; THEN&#13;&#10;    IF CONTAINS([제품명], &quot;요거트&quot;) THEN &quot;요거트 블렌디드&quot;&#13;&#10;    ELSEIF CONTAINS([제품명], &quot;티&quot;) OR CONTAINS([제품명], &quot;말차&quot;) THEN &quot;티 블렌디드&quot;&#13;&#10;    ELSE &quot;과일 블렌디드&quot;&#13;&#10;    END&#13;&#10;ELSEIF [Calculation_1603390474362882] = &quot;스타벅스 리프레셔&quot; THEN&#13;&#10;    &quot;스타벅스 리프레셔&quot;&#13;&#10;ELSEIF [Calculation_1603390474362882] = &quot;스타벅스 피지오&quot; THEN&#13;&#10;    IF CONTAINS([제품명], &quot;제주&quot;) OR CONTAINS([제품명], &quot;여수&quot;) THEN &quot;지역 한정 피지오&quot;&#13;&#10;    ELSE &quot;일반 피지오&quot;&#13;&#10;    END&#13;&#10;ELSEIF [Calculation_1603390474362882] = &quot;티(티바나)&quot; THEN&#13;&#10;    IF CONTAINS([제품명], &quot;라떼&quot;) OR CONTAINS([제품명], &quot;밀크 티&quot;) THEN &quot;티 라떼&quot;&#13;&#10;    ELSEIF CONTAINS([제품명], &quot;말차&quot;) THEN &quot;말차&quot;&#13;&#10;    ELSE &quot;기본 티&quot;&#13;&#10;    END&#13;&#10;ELSEIF [Calculation_1603390474362882] = &quot;기타 제조 음료&quot; THEN&#13;&#10;    IF CONTAINS([제품명], &quot;초콜릿&quot;) THEN &quot;초콜릿&quot;&#13;&#10;    ELSEIF CONTAINS([제품명], &quot;우유&quot;) THEN &quot;우유&quot;&#13;&#10;    ELSE &quot;기타&quot;&#13;&#10;    END&#13;&#10;ELSEIF [Calculation_1603390474362882] = &quot;스타벅스 주스(병음료)&quot; THEN&#13;&#10;    IF CONTAINS([제품명], &quot;주스&quot;) THEN &quot;주스&quot;&#13;&#10;    ELSEIF CONTAINS([제품명], &quot;요거트&quot;) THEN &quot;요거트&quot;&#13;&#10;    ELSEIF CONTAINS([제품명], &quot;클렌즈&quot;) THEN &quot;클렌즈&quot;&#13;&#10;    ELSE &quot;기타&quot;&#13;&#10;    END&#13;&#10;ELSE &quot;기타&quot;&#13;&#10;END' />
      </column>
      <column caption='건강 지수' datatype='integer' name='[Calculation_1603390480662532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// WHO 기준 건강 지수 (0-100점)&#13;&#10;// 칼로리 점수 (25점 만점) - WHO 기준: 200kcal&#13;&#10;IF [1회 제공량(kcal)] &lt;= 100 THEN 25&#13;&#10;ELSEIF [1회 제공량(kcal)] &lt;= 150 THEN 22&#13;&#10;ELSEIF [1회 제공량(kcal)] &lt;= 200 THEN 20&#13;&#10;ELSEIF [1회 제공량(kcal)] &lt;= 250 THEN 15&#13;&#10;ELSEIF [1회 제공량(kcal)] &lt;= 300 THEN 10&#13;&#10;ELSEIF [1회 제공량(kcal)] &lt;= 400 THEN 5&#13;&#10;ELSEIF [1회 제공량(kcal)] &lt;= 500 THEN 2&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;+&#13;&#10;// 당류 점수 (25점 만점) - WHO 기준: 25g&#13;&#10;IF [당류(g)] &lt;= 5 THEN 25&#13;&#10;ELSEIF [당류(g)] &lt;= 10 THEN 22&#13;&#10;ELSEIF [당류(g)] &lt;= 15 THEN 20&#13;&#10;ELSEIF [당류(g)] &lt;= 20 THEN 15&#13;&#10;ELSEIF [당류(g)] &lt;= 25 THEN 12&#13;&#10;ELSEIF [당류(g)] &lt;= 30 THEN 8&#13;&#10;ELSEIF [당류(g)] &lt;= 35 THEN 5&#13;&#10;ELSEIF [당류(g)] &lt;= 40 THEN 2&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;+&#13;&#10;// 카페인 점수 (20점 만점) - WHO 기준: 150mg&#13;&#10;IF [카페인(mg)] &lt;= 50 THEN 20&#13;&#10;ELSEIF [카페인(mg)] &lt;= 100 THEN 18&#13;&#10;ELSEIF [카페인(mg)] &lt;= 150 THEN 15&#13;&#10;ELSEIF [카페인(mg)] &lt;= 200 THEN 12&#13;&#10;ELSEIF [카페인(mg)] &lt;= 250 THEN 8&#13;&#10;ELSEIF [카페인(mg)] &lt;= 300 THEN 5&#13;&#10;ELSEIF [카페인(mg)] &lt;= 400 THEN 2&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;+&#13;&#10;// 포화지방 점수 (15점 만점) - WHO 기준: 5g&#13;&#10;IF [포화지방(g)] &lt;= 2 THEN 15&#13;&#10;ELSEIF [포화지방(g)] &lt;= 3 THEN 12&#13;&#10;ELSEIF [포화지방(g)] &lt;= 4 THEN 10&#13;&#10;ELSEIF [포화지방(g)] &lt;= 5 THEN 8&#13;&#10;ELSEIF [포화지방(g)] &lt;= 8 THEN 5&#13;&#10;ELSEIF [포화지방(g)] &lt;= 10 THEN 3&#13;&#10;ELSEIF [포화지방(g)] &lt;= 15 THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;+&#13;&#10;// 나트륨 점수 (10점 만점) - WHO 기준: 200mg&#13;&#10;IF [나트륨(mg)] &lt;= 50 THEN 10&#13;&#10;ELSEIF [나트륨(mg)] &lt;= 100 THEN 8&#13;&#10;ELSEIF [나트륨(mg)] &lt;= 150 THEN 6&#13;&#10;ELSEIF [나트륨(mg)] &lt;= 200 THEN 5&#13;&#10;ELSEIF [나트륨(mg)] &lt;= 250 THEN 3&#13;&#10;ELSEIF [나트륨(mg)] &lt;= 300 THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;+&#13;&#10;// 총 지방 점수 (5점 만점) - WHO 기준: 10g&#13;&#10;IF [지방(g)] &lt;= 3 THEN 5&#13;&#10;ELSEIF [지방(g)] &lt;= 5 THEN 4&#13;&#10;ELSEIF [지방(g)] &lt;= 7 THEN 3&#13;&#10;ELSEIF [지방(g)] &lt;= 10 THEN 2&#13;&#10;ELSEIF [지방(g)] &lt;= 15 THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='건강 등급' datatype='string' name='[Calculation_1603390480719877]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1603390480662532] &gt;= 85 THEN &quot;A+&quot;&#13;&#10;ELSEIF [Calculation_1603390480662532] &gt;= 75 THEN &quot;A&quot;&#13;&#10;ELSEIF [Calculation_1603390480662532] &gt;= 60 THEN &quot;B&quot;&#13;&#10;ELSEIF [Calculation_1603390480662532] &gt;= 45 THEN &quot;C&quot;&#13;&#10;ELSEIF [Calculation_1603390480662532] &gt;= 30 THEN &quot;D&quot;&#13;&#10;ELSE &quot;F&quot;&#13;&#10;END' />
      </column>
      <column caption='카페인' datatype='integer' name='[Calculation_1702072879210496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 3] = &quot;고카페인&quot; THEN&#13;&#10;    [카페인(mg)]&#13;&#10;ELSE&#13;&#10;    -[카페인(mg)]&#13;&#10;END' />
      </column>
