      <column caption='카페인 등급' datatype='string' name='[Calculation_0220754679812099]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [카페인(mg)] &lt;= 100 THEN &quot;저카페인&quot;&#13;&#10;ELSEIF [카페인(mg)] &lt;= 200 THEN &quot;중카페인&quot;&#13;&#10;ELSE &quot;고카페인&quot;&#13;&#10;END' />
      </column>
      <column caption='온도 구분' datatype='string' name='[Calculation_0220754679873540]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([제품명], &quot;아이스&quot;) OR CONTAINS([제품명], &quot;오버 아이스&quot;) OR CONTAINS([제품명], &quot;스파클링&quot;) &#13;&#10;   OR CONTAINS([제품명], &quot;콜드 브루&quot;) OR CONTAINS([제품명], &quot;나이트로&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;프라푸치노&quot;) &#13;&#10;   OR CONTAINS([제품명], &quot;블렌디드&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;리프레셔&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;피지오&quot;) THEN &quot;아이스&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;핫&quot;) OR (CONTAINS([제품명], &quot;스팀&quot;) AND NOT CONTAINS([제품명], &quot;스퀴즈드&quot;)) THEN &quot;핫&quot;&#13;&#10;ELSEIF CONTAINS([제품명], &quot;주스&quot;) AND (CONTAINS([제품명], &quot;ML&quot;) OR CONTAINS([제품명], &quot;190&quot;) OR CONTAINS([제품명], &quot;100&quot;)) THEN &quot;기본&quot;&#13;&#10;ELSE &quot;핫&quot;&#13;&#10;END' />
      </column>
