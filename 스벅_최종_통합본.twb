      <table>
        <view>
          <datasources>
            <datasource caption='starbucks_join' name='federated.1vbcdsd1upd2p81fpr0r51qee8eg' />
          </datasources>
          <datasource-dependencies datasource='federated.1vbcdsd1upd2p81fpr0r51qee8eg'>
            <column caption='퍼널 구조' datatype='string' name='[Calculation_1412901893382151]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [event] == &apos;offer received&apos; THEN &quot;Offer Received&quot;&#13;&#10;ELSEIF [event] == &apos;offer viewed&apos; THEN &quot;Offer Viewed&quot;&#13;&#10;ELSEIF [event] == &apos;offer completed&apos; THEN &quot;Offer Completed&quot;&#13;&#10;END' />
            </column>
            <column caption='C_연령대' datatype='string' name='[Calculation_2143800431591424]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [age] &gt;= 18 AND [age] &lt;= 29 THEN &quot;10-20대&quot;&#13;&#10;ELSEIF [age] &lt;= 49 THEN &quot;30-40대&quot;&#13;&#10;ELSEIF [age] &lt;= 69 THEN &quot;50-60대&quot;&#13;&#10;ELSE &quot;70대 이상&quot;&#13;&#10;END' />
            </column>
            <column caption='성숙도' datatype='string' name='[Calculation_2555567308808199]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2873600913870856] &lt; 6 THEN &quot;신규 고객 (0-6개월)&quot;&#13;&#10;ELSEIF [Calculation_2873600913870856] &lt;= 18 THEN &quot;성장 고객 (6-18개월)&quot;&#13;&#10;ELSEIF [Calculation_2873600913870856] &lt;= 42 THEN &quot;성숙 고객 (18-42개월)&quot;&#13;&#10;ELSE &quot;장기 고객 (42개월 이상)&quot;&#13;&#10;END' />
            </column>
            <column caption='C_가입 기간(월) 계산' datatype='integer' name='[Calculation_2873600913870856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [became_member_on], DATE(&apos;2018-07-31&apos;))' />
            </column>
            <column caption='C_Offer Completed Count' datatype='integer' name='[Calculation_2873600917934094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [event] = &apos;offer completed&apos; THEN 1 ELSE 0 END' />
            </column>
            <column caption='C_Offer Viewed Count' datatype='integer' name='[Calculation_2873600918777872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [event] = &apos;offer viewed&apos; THEN 1 ELSE 0 END' />
            </column>
            <column caption='전환율 (반응 → 완료)' datatype='real' default-format='p0.00%' name='[Calculation_2873600918933521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2873600917934094]) / SUM([Calculation_2873600918777872])' />
            </column>
            <column caption='Age' datatype='integer' name='[age]' role='measure' type='ordinal' />
            <column caption='Became Member On' datatype='date' name='[became_member_on]' role='dimension' type='ordinal' />
