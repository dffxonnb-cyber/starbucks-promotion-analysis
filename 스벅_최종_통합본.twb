      <aliases enabled='yes' />
      <column caption='1회 제공량(Kcal)' datatype='integer' name='[1회 제공량(kcal)]' role='measure' type='quantitative' />
      <column caption='C_당류 순위 필터' datatype='integer' name='[C_카페인 순위 필터(복사본)_0905202726113282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([당류(g)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='C_칼로리 하이라이트' datatype='boolean' name='[Calculation_0029990047117314]' role='measure' type='nominal'>
        <calculation class='tableau' formula='AVG([1회 제공량(kcal)]) &gt;= 200' />
      </column>
      <column caption='C_고당 하이라이트' datatype='boolean' name='[Calculation_0029990047739910]' role='measure' type='nominal'>
        <calculation class='tableau' formula='AVG([당류(g)])&gt;=25 // who 기준 일일 권장량 50%' />
      </column>
      <column caption='C_저당메뉴' datatype='string' name='[Calculation_0029990106718215]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [당류(g)]&lt; 8.8 then &quot;저당메뉴&quot; ELSE &quot;고당메뉴&quot; END' />
      </column>
      <column caption='C_저당건수' datatype='integer' name='[Calculation_0120426026090500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0029990106718215] = &quot;저당메뉴&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='C_고당건수' datatype='integer' name='[Calculation_0120426026160133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0029990106718215] = &quot;고당메뉴&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='C_저당고당비율' datatype='real' name='[Calculation_0120426026233862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0120426026160133]/[Calculation_0120426026090500]' />
      </column>
      <column caption='C_비율텍스트' datatype='string' name='[Calculation_0120426026352647]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;1 : &quot; + STR(ROUND([Calculation_0120426026233862], 2))' />
      </column>
      <column caption='C_카테고리 필터링' datatype='boolean' name='[Calculation_0212508720693248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[매개 변수 1]=[제품명 (그룹)]' />
      </column>
      <column caption='C_칼로리 대비 단백질량' datatype='real' name='[Calculation_0650938661494786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[단백질(g)]/[1회 제공량(kcal)]' />
      </column>
      <column caption='C_카페인 순위 필터' datatype='integer' name='[Calculation_0905202725646337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([카페인(mg)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='integer' name='[F1]' role='measure' type='quantitative' />
