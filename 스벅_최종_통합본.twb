    <worksheet name='건강 추천 음료'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#68ba5b' fontname='맑은 고딕'>건강</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='맑은 고딕'> 추천 음료</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='starbucks_menu_260112(3)' name='federated.0x8ekaa09qmpkm1dmuopp1hnyhe2(2 복사본)' />
          </datasources>
          <datasource-dependencies datasource='federated.0x8ekaa09qmpkm1dmuopp1hnyhe2(2 복사본)'>
            <column caption='1회 제공량(Kcal)' datatype='integer' name='[1회 제공량(kcal)]' role='measure' type='quantitative' />
            <column caption='건강 지수' datatype='integer' name='[Calculation_1603390480662532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// WHO 기준 건강 지수 (0-100점)&#13;&#10;// 칼로리 점수 (25점 만점) - WHO 기준: 200kcal&#13;&#10;IF [1회 제공량(kcal)] &lt;= 100 THEN 25&#13;&#10;ELSEIF [1회 제공량(kcal)] &lt;= 150 THEN 22&#13;&#10;ELSEIF [1회 제공량(kcal)] &lt;= 200 THEN 20&#13;&#10;ELSEIF [1회 제공량(kcal)] &lt;= 250 THEN 15&#13;&#10;ELSEIF [1회 제공량(kcal)] &lt;= 300 THEN 10&#13;&#10;ELSEIF [1회 제공량(kcal)] &lt;= 400 THEN 5&#13;&#10;ELSEIF [1회 제공량(kcal)] &lt;= 500 THEN 2&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;+&#13;&#10;// 당류 점수 (25점 만점) - WHO 기준: 25g&#13;&#10;IF [당류(g)] &lt;= 5 THEN 25&#13;&#10;ELSEIF [당류(g)] &lt;= 10 THEN 22&#13;&#10;ELSEIF [당류(g)] &lt;= 15 THEN 20&#13;&#10;ELSEIF [당류(g)] &lt;= 20 THEN 15&#13;&#10;ELSEIF [당류(g)] &lt;= 25 THEN 12&#13;&#10;ELSEIF [당류(g)] &lt;= 30 THEN 8&#13;&#10;ELSEIF [당류(g)] &lt;= 35 THEN 5&#13;&#10;ELSEIF [당류(g)] &lt;= 40 THEN 2&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;+&#13;&#10;// 카페인 점수 (20점 만점) - WHO 기준: 150mg&#13;&#10;IF [카페인(mg)] &lt;= 50 THEN 20&#13;&#10;ELSEIF [카페인(mg)] &lt;= 100 THEN 18&#13;&#10;ELSEIF [카페인(mg)] &lt;= 150 THEN 15&#13;&#10;ELSEIF [카페인(mg)] &lt;= 200 THEN 12&#13;&#10;ELSEIF [카페인(mg)] &lt;= 250 THEN 8&#13;&#10;ELSEIF [카페인(mg)] &lt;= 300 THEN 5&#13;&#10;ELSEIF [카페인(mg)] &lt;= 400 THEN 2&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;+&#13;&#10;// 포화지방 점수 (15점 만점) - WHO 기준: 5g&#13;&#10;IF [포화지방(g)] &lt;= 2 THEN 15&#13;&#10;ELSEIF [포화지방(g)] &lt;= 3 THEN 12&#13;&#10;ELSEIF [포화지방(g)] &lt;= 4 THEN 10&#13;&#10;ELSEIF [포화지방(g)] &lt;= 5 THEN 8&#13;&#10;ELSEIF [포화지방(g)] &lt;= 8 THEN 5&#13;&#10;ELSEIF [포화지방(g)] &lt;= 10 THEN 3&#13;&#10;ELSEIF [포화지방(g)] &lt;= 15 THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;+&#13;&#10;// 나트륨 점수 (10점 만점) - WHO 기준: 200mg&#13;&#10;IF [나트륨(mg)] &lt;= 50 THEN 10&#13;&#10;ELSEIF [나트륨(mg)] &lt;= 100 THEN 8&#13;&#10;ELSEIF [나트륨(mg)] &lt;= 150 THEN 6&#13;&#10;ELSEIF [나트륨(mg)] &lt;= 200 THEN 5&#13;&#10;ELSEIF [나트륨(mg)] &lt;= 250 THEN 3&#13;&#10;ELSEIF [나트륨(mg)] &lt;= 300 THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;+&#13;&#10;// 총 지방 점수 (5점 만점) - WHO 기준: 10g&#13;&#10;IF [지방(g)] &lt;= 3 THEN 5&#13;&#10;ELSEIF [지방(g)] &lt;= 5 THEN 4&#13;&#10;ELSEIF [지방(g)] &lt;= 7 THEN 3&#13;&#10;ELSEIF [지방(g)] &lt;= 10 THEN 2&#13;&#10;ELSEIF [지방(g)] &lt;= 15 THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='건강 음료' datatype='string' name='[Calculation_1961833168826378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([제품명], &quot;클렌즈&quot;) &#13;&#10;   OR CONTAINS([제품명], &quot;ABC&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;케일&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;라이트&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;에너지&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;스퀴즈드&quot;)&#13;&#10;   OR CONTAINS([제품명], &quot;유기농&quot;)&#13;&#10;   OR (CONTAINS([제품명], &quot;주스&quot;) AND [당류(g)] &lt;= 20)&#13;&#10;THEN &quot;건강 음료&quot;&#13;&#10;ELSE &quot;일반 음료&quot;&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_1603390480662532]' derivation='Avg' name='[cum:avg:Calculation_1603390480662532:qk:1]' pivot='key' type='quantitative'>
              <table-calc aggregation='Sum' ordering-field='[federated.0x8ekaa09qmpkm1dmuopp1hnyhe2(2 복사본)].[none:제품명:nk]' ordering-type='Field' type='CumTotal' />
            </column-instance>
            <column-instance column='[Calculation_1961833168826378]' derivation='None' name='[none:Calculation_1961833168826378:nk]' pivot='key' type='nominal' />
            <column-instance column='[제품명]' derivation='None' name='[none:제품명:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1603390480662532]' derivation='Sum' name='[sum:Calculation_1603390480662532:qk]' pivot='key' type='quantitative' />
            <column caption='나트륨(Mg)' datatype='integer' name='[나트륨(mg)]' role='measure' type='quantitative' />
            <column caption='당류(G)' datatype='integer' name='[당류(g)]' role='measure' type='quantitative' />
            <column datatype='string' name='[제품명]' role='dimension' type='nominal' />
            <column caption='지방(G)' datatype='real' name='[지방(g)]' role='measure' type='quantitative' />
            <column caption='카페인(Mg)' datatype='integer' name='[카페인(mg)]' role='measure' type='quantitative' />
