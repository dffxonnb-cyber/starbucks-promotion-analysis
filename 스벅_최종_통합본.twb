      <column caption='카테고리' datatype='string' name='[제품명 (그룹)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[제품명]' new-bin='true'>
          <bin default-name='false' value='&quot;기타 제조 음료&quot;'>
            <value>&quot;딸기 아사이 레모네이드 스타벅스 리프레셔&quot;</value>
            <value>&quot;딸기 콜드폼 딸기 라떼&quot;</value>
            <value>&quot;딸기 콜드폼 초콜릿&quot;</value>
            <value>&quot;스타벅스 슬래머&quot;</value>
