        <calculation class='tableau' formula='{ FIXED [Calculation_1603390474362882] : AVG([1회 제공량(kcal)]) }' />
      </column>
      <column caption='대분류별 평균 당류' datatype='real' name='[Calculation_0220754680025094]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_1603390474362882] : AVG([당류(g)]) }' />
